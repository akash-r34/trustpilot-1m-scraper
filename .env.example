# Proxy configuration
PROXY_URL=                          # Single rotating proxy URL (alternative to file)
PROXY_FILE=data/proxies.txt         # File with proxy list

# Concurrency
CONCURRENCY=25                      # Parallel scrape workers for Trustpilot
EMAIL_CONCURRENCY=10                # Parallel workers for email extraction (Tier 1)

# Rate limiting
MAX_REQUESTS_PER_SECOND=10          # Starting rate limit
RETRY_DELAY_MS=1000                 # Base retry delay
MAX_RETRIES=5                       # Max retries per URL

# Paths
DB_PATH=data/scraper.db
OUTPUT_DIR=output/
USER_AGENTS_FILE=data/user-agents.txt

# Timeouts
PAGE_TIMEOUT_MS=30000               # 30s timeout per Trustpilot page
EMAIL_TIMEOUT_MS=15000              # 15s timeout per external domain

# Apify (optional — for fallback + email enrichment)
APIFY_TOKEN=                        # Get from https://console.apify.com/account/integrations

# Firecrawl (optional — for Tier 2 email extraction)
FIRECRAWL_API_KEY=                  # Get from https://www.firecrawl.dev/

# Feature flags
SKIP_EMAIL_PHASE=false
USE_FIRECRAWL_EMAILS=false
USE_APIFY_FALLBACK=false
USE_APIFY_EMAILS=false

# Logging
LOG_LEVEL=info                      # debug | info | warn | error
